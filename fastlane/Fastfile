default_platform(:ios)

platform :ios do

  desc "Run unit tests"
  lane :unit_tests do
    scan(
      project: "TraceWay.xcodeproj",
      scheme: "TraceWay"
    )
  end

  desc "Build TraceWay"
  lane :build do
    gym(
      project: "TraceWay.xcodeproj",
      scheme: "TraceWay",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.ranbijay.TraceWay" => "TraceWay AppStore Distribution"
        }
      }
    )
  end

desc "Run SwiftLint"
lane :lint do
  swiftlint(
    mode: :lint,
    ignore_exit_status: true
  )
end

  desc "Build and upload TraceWay to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"]
    )

    build_app(
      project: "TraceWay.xcodeproj",
      scheme: "TraceWay",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.ranbijay.TraceWay" => "TraceWay AppStore Distribution"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

end